{
  "git": {
    "raw": [
      {
        "alias": "git-raw"
      }
    ],
    "enrich": [
      {
        "alias": "git",
        "filter": {
          "bool": {
            "should": [
              {
                "bool": {
                  "must_not": [
                    {
                      "term": {
                        "origin": "https://github.com/ni/linux.git"
                      }
                    }
                  ]
                }
              },
              {
                "range": {
                  "grimoire_creation_date": {
                    "gte": "2014-06-20T14:25:04Z"
                  }
                }
              }
            ],
            "minimum_should_match": 1
          }
        }
      },
      {
        "alias": "affiliations"
      },
      {
        "alias": "all_enriched"
      }
    ]
  },
  "github": {
    "raw": [
      {
        "alias": "github-raw"
      }
    ],
    "enrich": [
      {
        "alias": "github_issues"
      },
      {
        "alias": "affiliations"
      },
      {
        "alias": "all_enriched"
      },
      {
        "alias": "all_enriched_tickets",
        "filter": {
          "terms": {
            "pull_request": [
              "false"
            ]
          }
        }
      },
      {
        "alias": "github_issues_onion-src",
        "filter": {
          "terms": {
            "pull_request": [
              "false"
            ]
          }
        }
      },
      {
        "alias": "github_prs_onion-src",
        "filter": {
          "terms": {
            "pull_request": [
              "true"
            ]
          }
        }
      }
    ]
  }
}
